<UserControl x:Class="PiAgentGui.Views.ProcessesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PiAgentGui.Models.Pi"
    xmlns:controls="using:PiAgentGui.Controls">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12,0,0,0" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Height="36">
            <TextBlock Text="Processes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <controls:ActionButton HorizontalAlignment="Right" Click="OnClose" Padding="6" MinWidth="28" MinHeight="28"
                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close processes" AutomationProperties.Name="Close processes">
                <FontIcon Glyph="&#xE711;" FontSize="11"/>
            </controls:ActionButton>
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="{Binding HasError}" Message="{Binding Error}" Severity="Error" IsClosable="False"/>
        <ListView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:AgentProcess">
                <Grid Margin="0,5" ColumnSpacing="8" Background="Transparent" PointerEntered="OnRowEntered" PointerExited="OnRowExited" GotFocus="OnRowFocused" LostFocus="OnRowUnfocused">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.ContextFlyout><MenuFlyout>
                        <controls:ActionMenuFlyoutItem Text="Stop process" Tag="{x:Bind}" Click="OnStop">
                            <controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;"/></controls:ActionMenuFlyoutItem.Icon>
                        </controls:ActionMenuFlyoutItem>
                    </MenuFlyout></Grid.ContextFlyout>
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                    <controls:ActionButton Grid.Column="1" Tag="{x:Bind}" Click="OnStop" Opacity="0" Padding="6" MinWidth="28" MinHeight="28"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Stop process" AutomationProperties.Name="Stop process">
                        <FontIcon Glyph="&#xE71A;" FontSize="11"/>
                    </controls:ActionButton>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,8,12,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{Binding ShowMessage, Converter={StaticResource BooleanToVisibility}}"/>
    </Grid>
</UserControl>
