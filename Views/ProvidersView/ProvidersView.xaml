<UserControl x:Class="PiAgentGui.Views.ProvidersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls"
    xmlns:providers="using:PiAgentGui.ViewModels.Providers">
    <GridView x:Name="ProviderCards" ItemsSource="{Binding Cards}" SelectionMode="None" IsTabStop="False"
        Loaded="OnCardsLoaded" SizeChanged="OnCardsSizeChanged" HorizontalContentAlignment="Stretch"
        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        AutomationProperties.Name="Providers">
        <GridView.Header>
            <StackPanel Spacing="8" Margin="0,0,12,24">
                <Grid>
                    <TextBlock Text="Providers" FontSize="24" FontWeight="SemiBold" />
                    <controls:ActionButton HorizontalAlignment="Right" Style="{StaticResource ShellIconButtonStyle}"
                        Click="OnRefreshClicked" IsEnabled="{Binding CanInteract}" ToolTipService.ToolTip="Refresh providers" AutomationProperties.Name="Refresh providers">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </controls:ActionButton>
                </Grid>
                <TextBlock Text="Connect your model providers across all projects. Pi manages sign-in and credentials; each conversation keeps its own model selection."
                    TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Configured means credentials are present, not that access has been verified." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </GridView.Header>
        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate></GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="providers:ProviderCardViewModel">
                <Border Padding="20" Margin="0,0,12,12" CornerRadius="8" BorderThickness="1" Loaded="OnCardsLoaded"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12" SizeChanged="OnCardsSizeChanged">
                        <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ModelCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Content="Details" Click="OnDetailsClicked" />
                            <controls:ActionButton Content="{x:Bind SetupLabel}" Click="OnSetupClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>
