<UserControl
    x:Class="PiAgentGui.Views.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:PiAgentGui.ViewModels.Conversations"
    xmlns:controls="using:PiAgentGui.Controls"
    FontSize="13" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="ComposerSelectorStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,4,0,4"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="ComposerActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Circle.Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Circle.Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Circle.Fill" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                            <Setter Target="Icon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse x:Name="Circle" Margin="1" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ContentPresenter x:Name="Icon" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ToolTemplate" x:DataType="chat:ChatEntryViewModel">
            <StackPanel Spacing="4">
                <controls:ActionToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="6,4" MinHeight="28" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind ToolSummary, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind ExpansionGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ToolSummary, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </controls:ActionToggleButton>
                <StackPanel Spacing="8" Margin="24,4,0,8" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <controls:FileDiffView Patch="{x:Bind DiffPatch, Mode=OneWay}"
                        Visibility="{x:Bind HasDiff, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{x:Bind DiffNotice, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                        Visibility="{x:Bind HasDiffNotice, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ShowRawToolDetails, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="11"
                        Visibility="{x:Bind HasDetails, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RunSummaryTemplate">
                    <Border CornerRadius="10" BorderThickness="1"
                        HorizontalAlignment="Stretch" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        >
                        <StackPanel>
                            <Grid Padding="12" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" ToolTipService.ToolTip="Lines added and removed across this run's captured edits.">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Added}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Removed}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="11" />
                                    <TextBlock Text="Some counts unavailable" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{Binding HasUnknownCounts, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                <controls:ActionButton Click="OnRevertChanges" Padding="6,4" MinHeight="28" FontSize="11"
                                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="Preview checkpoint changes before restoring files." AutomationProperties.Name="Revert this request's file changes">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="11" />
                                        <TextBlock Text="Revert" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </controls:ActionButton>
                                <controls:ActionButton Click="OnUndoRevert" Padding="6,4" MinHeight="28" FontSize="11"
                                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="Undo the file restoration." AutomationProperties.Name="Undo revert"
                                    Visibility="{Binding CanUndoRevert, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE7A6;" FontSize="11" />
                                        <TextBlock Text="Undo" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </controls:ActionButton>
                            </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding CaptureNotice}" TextWrapping="Wrap" Margin="12,0,12,8" FontSize="11"
                                Visibility="{Binding HasCaptureNotice, Converter={StaticResource BooleanToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding VisibleFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="chat:ChangedFileViewModel">
                                        <controls:ActionExpander Expanding="OnFileDiffExpanding" Collapsed="OnFileDiffCollapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0" Padding="0" MinHeight="32">
                                            <controls:ActionExpander.Header>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Added}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="11" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Removed}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="11" />
                                                </Grid>
                                            </controls:ActionExpander.Header>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Diff unavailable for some edits to this file." TextWrapping="Wrap" FontSize="11"
                                                    Visibility="{x:Bind HasUnknownCounts, Converter={StaticResource BooleanToVisibility}}" />
                                            </StackPanel>
                                        </controls:ActionExpander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding VerificationRows}" Margin="12,8,12,8"
                                Visibility="{Binding HasVerification, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="{Binding Passed, Converter={StaticResource BooleanToVisibility}}" />
                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Visibility="{Binding Failed, Converter={StaticResource BooleanToVisibility}}" />
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DiagnosticsLabel}" Margin="12,8" FontSize="11" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                ToolTipService.ToolTip="Latest completed LSP check for changed files. Separate from build, lint and test results."
                                Visibility="{Binding HasDiagnostics, Converter={StaticResource BooleanToVisibility}}" />
                            <controls:ActionToggleButton Content="{Binding MoreLabel}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Background="Transparent" BorderThickness="0"
                                Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="Root">
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
            <ProgressRing Width="32" Height="32" IsActive="{Binding IsLoading}"
                AutomationProperties.Name="Loading conversation" />
            <TextBlock Text="Loading conversation…" TextWrapping="Wrap" TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding ShowRecovery, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel MaxWidth="440" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ErrorHelp}" TextWrapping="Wrap" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ActionButton Content="Reconnect" Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}" />
                    <controls:ActionButton Content="Details" Click="OnErrorDetails" ToolTipService.ToolTip="Copyable diagnostics"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Visibility="{Binding IsReady, Converter={StaticResource BooleanToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PromptNavigationRail x:Name="PromptRail" Grid.Row="1" Margin="0,0,8,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Send a message to start working in this project's folder." TextWrapping="Wrap"
                MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
            <ListView x:Name="Transcript" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DisplayEntries}" SelectionMode="None"
                LayoutUpdated="OnTranscriptLayoutUpdated"
                IsItemClickEnabled="False" HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="Conversation messages">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="chat:ChatEntryViewModel">
                        <Grid Padding="4,0,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                                Visibility="{x:Bind IsProcessing, Converter={StaticResource BooleanToVisibility}}">
                                <ProgressRing Width="12" Height="12" MinWidth="0" MinHeight="0" IsActive="{x:Bind IsProcessing}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource ToolTemplate}" HorizontalContentAlignment="Stretch" Margin="0,0,0,2"
                                Visibility="{x:Bind IsTool, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            <StackPanel Spacing="4" Margin="0,0,0,8"
                                Visibility="{x:Bind IsToolGroup, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <controls:ActionToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="6,4" MinHeight="28" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind GroupSummary, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind ExpansionGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind GroupSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </controls:ActionToggleButton>
                                <ItemsControl ItemsSource="{x:Bind Tools, Mode=OneWay}" ItemTemplate="{StaticResource ToolTemplate}" Margin="16,0,0,0"
                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" MaxWidth="640" Margin="48,0,0,18" Spacing="4"
                                Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <Border Padding="13,9" CornerRadius="13" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <StackPanel Spacing="8">
                                    <ItemsControl ItemsSource="{x:Bind Images, Mode=OneWay}" Visibility="{x:Bind HasImages, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><controls:ScreenshotPreview Image="{Binding}" Margin="0,0,0,6" AutomationProperties.Name="Attached screenshot" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <controls:CopyFeedbackButton Click="OnCopyMessageClicked" HorizontalAlignment="Right" Style="{StaticResource ShellIconButtonStyle}"
                                    AutomationProperties.Name="Copy prompt" ToolTipService.ToolTip="Copy prompt"
                                    Visibility="{x:Bind CanCopyUser, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                            <StackPanel Spacing="6" HorizontalAlignment="Stretch" Margin="0,0,0,18"
                                Visibility="{x:Bind IsLeftAligned, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                Visibility="{x:Bind HasHeader, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{x:Bind Speaker, Mode=OneWay}" FontWeight="SemiBold"
                                    Visibility="{x:Bind ShowSpeaker, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <controls:MarkdownMessage Text="{x:Bind Text, Mode=OneWay}" SizeChanged="OnMessageSizeChanged" />
                            <ContentControl Content="{x:Bind Summary, Mode=OneWay}" ContentTemplate="{StaticResource RunSummaryTemplate}" HorizontalContentAlignment="Stretch" Visibility="{x:Bind HasSummary, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Spacing="4"
                                Visibility="{x:Bind ShowInlineActions, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <controls:CopyFeedbackButton Click="OnCopyMessageClicked" HorizontalAlignment="Left" Style="{StaticResource ShellIconButtonStyle}"
                                AutomationProperties.Name="Copy response" ToolTipService.ToolTip="Copy response"
                                Visibility="{x:Bind ShowConversationActions, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            <controls:ActionButton Command="{x:Bind ForkCommand}" IsEnabled="{x:Bind CanDuplicate, Mode=OneWay}"
                                Style="{StaticResource ShellIconButtonStyle}" AutomationProperties.Name="Fork conversation"
                                ToolTipService.ToolTip="Fork: continue in a new conversation"
                                Visibility="{x:Bind ShowConversationActions, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </controls:ActionButton>
                            <controls:ActionButton Command="{x:Bind CloneCommand}" IsEnabled="{x:Bind CanDuplicate, Mode=OneWay}"
                                Style="{StaticResource ShellIconButtonStyle}" AutomationProperties.Name="Clone conversation"
                                ToolTipService.ToolTip="Clone: duplicate and stay here"
                                Visibility="{x:Bind ShowConversationActions, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <FontIcon Glyph="&#xF413;" FontSize="14" />
                            </controls:ActionButton>
                            <TextBlock Text="{x:Bind UsageLabel, Mode=OneWay}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                ToolTipService.ToolTip="Whole-run reported tokens, including input, output and cache usage. Elapsed time includes tools and waiting for approval."
                                Visibility="{x:Bind HasUsage, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <ScrollViewer Grid.Row="2" MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Prompts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="chat:ExtensionPromptViewModel">
                        <Border Padding="16" Margin="0,0,0,8" BorderThickness="1" CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="120"
                                    AutomationProperties.Name="Response"
                                    Visibility="{x:Bind IsText, Converter={StaticResource BooleanToVisibility}}" />
                                <controls:ActionComboBox ItemsSource="{x:Bind Options}" SelectedItem="{x:Bind Value, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" PlaceholderText="Choose an option" AutomationProperties.Name="Response option"
                                    Visibility="{x:Bind IsSelect, Converter={StaticResource BooleanToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:ActionButton Content="{x:Bind SubmitLabel}" Command="{x:Bind SubmitCommand}" IsEnabled="{x:Bind IsPending, Mode=OneWay}" />
                                    <controls:ActionButton Content="Cancel" Command="{x:Bind CancelCommand}" IsEnabled="{x:Bind IsPending, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="3" Visibility="{Binding IsReady, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="6">
            <controls:ActionButton Click="OnConnectProvider" Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind GettingStarted.ProviderAction, Mode=OneWay}"
                Visibility="{x:Bind GettingStarted.ShowProviderSetup, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77B;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{x:Bind GettingStarted.ProviderAction, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind GettingStarted.ProviderMessage, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </controls:ActionButton>
            <Border Visibility="{Binding HasQueuedPrompt, Converter={StaticResource BooleanToVisibility}}" Padding="10,8" Margin="0,0,0,6" CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding QueueLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding QueuedPreview}" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:ActionButton Content="Edit" Command="{Binding EditQueuedCommand}" IsEnabled="{Binding CanChangeQueue}" FontSize="11" Padding="8,3" MinHeight="26" />
                        <controls:ActionButton Content="Remove" Command="{Binding RemoveQueuedCommand}" IsEnabled="{Binding CanChangeQueue}" FontSize="11" Padding="8,3" MinHeight="26" />
                        <controls:ActionButton Content="Steer now" Command="{Binding SteerQueuedCommand}" Visibility="{Binding CanSteerQueue, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="8,3" MinHeight="26" />
                        <controls:ActionButton Content="Resume" Command="{Binding ReleaseQueuedCommand}" Visibility="{Binding CanReleaseQueue, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="8,3" MinHeight="26" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding SteeringLabel}" Visibility="{Binding HasSteering, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Margin="0,0,0,6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding RecoveredPrompts}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Padding="8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Unsent steering message" FontSize="11" /><TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <controls:ActionButton Grid.Column="1" Content="Restore" Click="OnRestoreSteering" Tag="{Binding}" FontSize="11" />
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                Visibility="{Binding HasPendingImages, Converter={StaticResource BooleanToVisibility}}" MaxHeight="132">
                <ItemsControl ItemsSource="{Binding PendingImages}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <controls:ScreenshotPreview Image="{Binding}" Width="160" Height="108" AutomationProperties.Name="Screenshot ready to send" />
                                <controls:ActionButton Click="OnRemoveScreenshot" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    MinWidth="24" MinHeight="24" Padding="4" AutomationProperties.Name="Remove screenshot" ToolTipService.ToolTip="Remove screenshot">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </controls:ActionButton>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="FileReferencePanel" Visibility="Collapsed" Padding="4" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Reference a file" FontSize="11" Margin="8,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:CommandListView x:Name="FileReferenceList" MaxHeight="200" IsItemClickEnabled="True"
                        ItemClick="OnFileReferenceClicked" KeyDown="OnFileReferenceKeyDown" SelectionMode="Single" DisplayMemberPath="Label" AutomationProperties.Name="File references" />
                    <controls:ActionButton Content="Browse…" Click="OnBrowseReference" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Choose a file inside or outside the project" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="CommandSurface" Spacing="4" Margin="0,0,0,8" Visibility="Collapsed">
                <InfoBar x:Name="CommandNotice" IsOpen="False" IsClosable="True" Severity="Informational" Closed="OnCommandNoticeClosed" />
                <Border x:Name="CommandPanel" Visibility="Collapsed" Padding="4" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="CommandHint" Text="Commands" Margin="8,4" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:CommandListView x:Name="CommandList" MaxHeight="240" SelectionMode="Single" IsItemClickEnabled="True"
                            ItemClick="OnCommandClicked" KeyDown="OnCommandListKeyDown" AutomationProperties.Name="Commands">
                            <controls:CommandListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </controls:CommandListView.ItemContainerStyle>
                            <controls:CommandListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,5" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:CommandListView.ItemTemplate>
                        </controls:CommandListView>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Grid.RowSpan="2" CornerRadius="20" Padding="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="Composer" Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Paste="OnComposerPaste"
                TextChanged="OnComposerTextChanged" SelectionChanged="OnComposerSelectionChanged" PreviewKeyDown="OnComposerPreviewKeyDown"
                TextCompositionStarted="OnCompositionStarted" TextCompositionEnded="OnCompositionEnded"
                KeyboardAcceleratorPlacementMode="Hidden"
                PlaceholderText="Message Pi…" AutomationProperties.Name="Message Pi" AcceptsReturn="True"
                FontSize="14" TextWrapping="Wrap" MinHeight="48" MaxHeight="184" VerticalContentAlignment="Top" Padding="4,6"
                Background="Transparent" BorderThickness="0">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                </TextBox.Resources>
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" ScopeOwner="{x:Bind Composer}" Invoked="OnSendInvoked" />
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" ScopeOwner="{x:Bind Composer}" Invoked="OnNewLineInvoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <Grid x:Name="ComposerToolbar" Grid.Row="1" ColumnSpacing="4" RowSpacing="4" SizeChanged="OnComposerToolbarSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <controls:ActionComboBox x:Name="ApprovalSelector" Style="{StaticResource ComposerSelectorStyle}" Width="132"
                        Loaded="OnApprovalSelectorLoaded" SelectionChanged="OnApprovalSelectionChanged" IsEnabled="{Binding CanChangeApprovalMode}"
                        PlaceholderText="Approval" AutomationProperties.Name="Approval mode" ToolTipService.ToolTip="Approval mode"
                        Visibility="{Binding HasApprovalModes, Converter={StaticResource BooleanToVisibility}}">
                        <controls:ActionComboBox.ItemTemplate><DataTemplate>
                            <TextBlock><Run Text="Approval: "/><Run Text="{Binding}"/></TextBlock>
                        </DataTemplate></controls:ActionComboBox.ItemTemplate>
                    </controls:ActionComboBox>
                    <controls:ActionButton Click="OnApprovalSetupClicked" Background="Transparent" BorderThickness="0" Padding="8,4"
                        AutomationProperties.Name="Set up approval modes" ToolTipService.ToolTip="{Binding ApprovalStatus}"
                        Visibility="{Binding ShowApprovalSetup, Converter={StaticResource BooleanToVisibility}}" Content="Approval"/>
                </StackPanel>
                <Grid x:Name="ComposerModelActions" Grid.Column="1" ColumnSpacing="4" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <controls:ModelPicker x:Name="ModelSelector" Width="220" Loaded="OnModelSelectorLoaded"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding CanChangeModel}"/>
                    <controls:ActionComboBox x:Name="ThinkingSelector" Grid.Column="1" Style="{StaticResource ComposerSelectorStyle}" Width="112"
                        Loaded="OnThinkingSelectorLoaded" SelectionChanged="OnThinkingSelectionChanged" IsEnabled="{Binding CanChangeThinkingLevel}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" PlaceholderText="Effort" AutomationProperties.Name="Reasoning effort" ToolTipService.ToolTip="Reasoning effort">
                        <controls:ActionComboBox.ItemTemplate><DataTemplate>
                            <TextBlock><Run Text="Effort: "/><Run Text="{Binding}"/></TextBlock>
                        </DataTemplate></controls:ActionComboBox.ItemTemplate>
                    </controls:ActionComboBox>
                    <controls:ComposerActionButton Grid.Column="3" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                        Visibility="{Binding ShowSeparateStop, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.Name="Stop" ToolTipService.ToolTip="Stop" Style="{StaticResource ComposerActionStyle}"
                        Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" CornerRadius="16" BorderThickness="0">
                        <controls:ComposerActionIcon IsRunning="True"/>
                    </controls:ComposerActionButton>
                    <controls:ComposerActionButton Grid.Column="4" Command="{Binding ComposerActionCommand}" IsEnabled="{Binding CanUseComposerAction}"
                        AutomationProperties.Name="{Binding ComposerActionLabel}" ToolTipService.ToolTip="{Binding ComposerActionLabel}"
                        Style="{StaticResource ComposerActionStyle}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                        Padding="0" CornerRadius="16" BorderThickness="0" UseLayoutRounding="True">
                        <controls:ComposerActionIcon IsRunning="{Binding ComposerShowsStop}"/>
                    </controls:ComposerActionButton>
                </Grid>
            </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
    <StackPanel VerticalAlignment="Top">
        <InfoBar IsOpen="{Binding HasCheckpointRecovery}" Severity="Warning" IsClosable="False" Title="Checkpoint recovery" Message="{Binding CheckpointStatus}">
            <InfoBar.ActionButton><controls:ActionButton Content="Inspect recovery" Click="OnCheckpointRecovery" /></InfoBar.ActionButton>
        </InfoBar>
        <InfoBar IsOpen="{Binding HasInlineError}" Severity="Error" IsClosable="True" CloseButtonClick="OnDismissError"
            Title="{Binding ErrorTitle}" Message="{Binding Error}">
            <InfoBar.ActionButton><controls:ActionButton Content="Details" Click="OnErrorDetails" ToolTipService.ToolTip="Recovery guidance and copyable diagnostics"/></InfoBar.ActionButton>
        </InfoBar>
        <InfoBar IsOpen="{Binding HasInlineWarning}" Severity="Warning" IsClosable="False"
            Title="Extension notice" Message="{Binding Warning}" />
    </StackPanel>
    </Grid>
</UserControl>
