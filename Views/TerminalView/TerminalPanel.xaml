<UserControl x:Class="PiAgentGui.Views.TerminalPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TabView x:Name="TerminalTabs" TabWidthMode="SizeToContent" CanReorderTabs="False"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            AddTabButtonClick="OnAddTabClicked" TabCloseRequested="OnTabCloseRequested" SelectionChanged="OnSelectionChanged"
            AutomationProperties.Name="Terminal tabs">
            <TabView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#3A3A3A" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource SystemColorWindowColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <controls:ActionButton Click="OnHideClicked" MinWidth="28" MinHeight="28" Padding="5"
                    Margin="4,0,4,0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Hide terminal panel" AutomationProperties.Name="Hide terminal panel">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </controls:ActionButton>
            </TabView.TabStripHeader>
        </TabView>
        <Grid x:Name="TerminalDisplays" Grid.Row="1" />
    </Grid>
</UserControl>
