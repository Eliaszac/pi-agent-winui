<UserControl x:Class="PiAgentGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls" xmlns:views="using:PiAgentGui.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="UsageGroupTemplate">
            <StackPanel Spacing="5" Margin="0,0,0,16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
                </Grid>
                <ProgressBar Value="{Binding Share}" Maximum="100" Height="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Caption}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="OnViewportSizeChanged">
        <Grid x:Name="HomeViewport">
        <Grid x:Name="ContentGrid" MaxWidth="1000" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,24" SizeChanged="OnContentSizeChanged" RowSpacing="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ActionButton Content="New conversation" Click="OnNewConversation" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanCreateConversation}"/>
                    <controls:ActionButton Content="Open project" Click="OnOpenProject" IsEnabled="{Binding CanCreateConversation}"/>
                    <controls:ActionButton Click="OnAddProject" IsEnabled="{Binding CanManageProjects}" ToolTipService.ToolTip="Add project" AutomationProperties.Name="Add project">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    </controls:ActionButton>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock Text="Recent conversations" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Spacing="12" Padding="0,8" Visibility="{Binding HasNoRecent, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="Your next conversation starts here." FontSize="16"/>
                    <TextBlock Text="{Binding RecentEmptyDescription}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <controls:ActionButton Content="Add project" Click="OnAddProject" IsEnabled="{Binding CanManageProjects}" HorizontalAlignment="Left"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <controls:ActionButton Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="12,10" Margin="-12,0" ToolTipService.ToolTip="{Binding Title}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProjectName}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding LastOpened}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </controls:ActionButton>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="18" Visibility="{Binding ShowLocalUsage, Converter={StaticResource BooleanToVisibility}}">
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Local usage" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding RangeIndex, Mode=TwoWay}" AutomationProperties.Name="Usage time period">
                        <ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/>
                    </ComboBox>
                    <controls:ActionButton Grid.Column="2" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh local usage" ToolTipService.ToolTip="Refresh local usage">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </controls:ActionButton>
                </Grid>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"/>
                <InfoBar Severity="Warning" IsOpen="{Binding HasError}" Message="{Binding Error}" IsClosable="False"/>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6"><TextBlock Text="{Binding TokenTotal}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TokenTotal}"/><TextBlock Text="Reported tokens" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding ResponseTotal}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Model responses" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="{Binding ProjectTotal}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Active projects" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Grid>
                <StackPanel Spacing="8" Visibility="{Binding HasUsage, Converter={StaticResource BooleanToVisibility}}">
                    <views:HomeUsageChart Days="{Binding Days}"/>
                    <Grid><TextBlock Text="{Binding PeriodStart}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding PeriodEnd}" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
                </StackPanel>
                <TextBlock Text="No recorded usage in this period. As you work with Pi, your model and token activity will appear here."
                    TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding ShowUsageEmpty, Converter={StaticResource BooleanToVisibility}}"/>
                <Grid x:Name="Breakdowns" ColumnSpacing="32" RowSpacing="16" Visibility="{Binding HasUsage, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="ModelBreakdown" Spacing="16"><TextBlock Text="Models · by reported tokens" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Models}" ItemTemplate="{StaticResource UsageGroupTemplate}"/></StackPanel>
                    <StackPanel x:Name="ProjectBreakdown" Grid.Column="1" Spacing="16"><TextBlock Text="Projects · by reported tokens" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource UsageGroupTemplate}"/></StackPanel>
                </Grid>
                <TextBlock Text="{Binding Coverage}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <controls:ActionButton Content="About local usage" HorizontalAlignment="Left" FontSize="12" Padding="0" Background="Transparent" BorderThickness="0">
                    <controls:ActionButton.Flyout><Flyout>
                        <TextBlock MaxWidth="350" TextWrapping="Wrap" Text="Calculated from this app’s saved Pi conversations, including their stored branches. Tokens include input, output, cache reads and cache writes. Responses are individual assistant messages, not prompts. Background research, provider management and other usage outside those messages are not included. This is not account-wide usage or a bill. No analytics database is created or uploaded; deleting a conversation removes its contribution unless its history remains in another saved fork."/>
                    </Flyout></controls:ActionButton.Flyout>
                </controls:ActionButton>
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{x:Bind VersionLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-10,0,0"/>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
