<controls:ActionContentDialog
    x:Class="PiAgentGui.Views.CreateProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls"
    Title="New project"
    PrimaryButtonText="Create project"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    PrimaryButtonClick="OnCreateClicked"
    Closing="OnClosing">
    <StackPanel Spacing="20" MinWidth="280" MaxWidth="440">
        <TextBlock Text="Choose an existing folder. Your files stay where they are."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <TextBox x:Name="ProjectName" Header="Project name" PlaceholderText="My project"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" MaxLength="120" />
        <StackPanel Spacing="8">
            <TextBox Header="Project folder" PlaceholderText="Choose a folder or enter its full path"
                Text="{x:Bind ViewModel.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            <controls:ActionButton x:Name="BrowseButton" Click="OnBrowseClicked" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xED25;" FontSize="16" />
                    <TextBlock Text="Browse folders" />
                </StackPanel>
            </controls:ActionButton>
        </StackPanel>
        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
            Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"
            AutomationProperties.Name="Saving project" />
    </StackPanel>
</controls:ActionContentDialog>


