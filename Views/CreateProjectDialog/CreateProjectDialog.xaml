<controls:ActionContentDialog x:Class="PiAgentGui.Views.CreateProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PiAgentGui.Controls"
    Title="New project" PrimaryButtonText="Create project" CloseButtonText="Cancel" DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" PrimaryButtonClick="OnCreateClicked" Closing="OnClosing">
    <controls:ActionContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">648</x:Double></controls:ActionContentDialog.Resources>
    <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FormContent" Width="560" Spacing="24">
            <TextBlock Text="Give your project a name and choose its first workspace." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="ProjectName" Header="Project name" PlaceholderText="My app" MaxLength="120"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            <controls:TargetWorkspaceForm x:Name="WorkspaceForm" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="Creating project" />
        </StackPanel>
    </ScrollViewer>
</controls:ActionContentDialog>
