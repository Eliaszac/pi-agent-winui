<controls:ActionContentDialog x:Class="PiAgentGui.Views.BranchesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PiAgentGui.Models.SourceControl"
    xmlns:controls="using:PiAgentGui.Controls"
    Title="Branches" CloseButtonText="Close" DefaultButton="Close">
    <Grid RowSpacing="12" MinWidth="340" MaxWidth="560">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding BranchName}" FontWeight="SemiBold"/>
            <InfoBar IsOpen="{Binding HasError}" Message="{Binding Error}" Severity="Error" IsClosable="False"/>
            <InfoBar IsOpen="{Binding HasNotice}" Message="{Binding Notice}" Severity="Success" IsClosable="False"/>
        </StackPanel>
        <TextBox x:Name="Filter" Grid.Row="1" PlaceholderText="Find a branch" TextChanged="OnFilterChanged" AutomationProperties.Name="Find a branch"/>
        <ListView x:Name="BranchList" Grid.Row="2" MaxHeight="320" SelectionMode="None" IsEnabled="{Binding CanAct}">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:GitBranch">
                <Grid ColumnSpacing="12" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <controls:ActionButton Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="7" ToolTipService.ToolTip="Branch actions" AutomationProperties.Name="Branch actions">
                        <FontIcon Glyph="&#xE712;" FontSize="13"/>
                        <controls:ActionButton.Flyout><MenuFlyout>
                            <controls:ActionMenuFlyoutItem Text="Checkout" Tag="{x:Bind}" IsEnabled="{x:Bind CanCheckout}" Click="OnCheckout"/>
                            <controls:ActionMenuFlyoutItem Text="Checkout from…" Tag="{x:Bind}" Click="OnCreateFrom"/>
                            <controls:ActionMenuFlyoutItem Text="Update branch (fetch)" Tag="{x:Bind}" IsEnabled="{x:Bind CanFetch}" Click="OnFetchBranch"/>
                            <controls:ActionMenuFlyoutItem Text="Merge into current branch" Tag="{x:Bind}" IsEnabled="{x:Bind CanCheckout}" Click="OnMerge"/>
                        </MenuFlyout></controls:ActionButton.Flyout>
                    </controls:ActionButton>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="CreateSection" Grid.Row="3" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="CreateLabel" TextWrapping="Wrap"/>
            <TextBox x:Name="NewBranchName" PlaceholderText="New branch name" AutomationProperties.Name="New branch name" IsEnabled="{Binding CanAct}" MaxLength="240"/>
            <controls:ActionButton Content="Create and checkout" Click="OnCreate" IsEnabled="{Binding CanAct}"/>
        </StackPanel>
    </Grid>
</controls:ActionContentDialog>
