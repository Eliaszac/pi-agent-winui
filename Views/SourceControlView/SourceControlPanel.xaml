<UserControl x:Class="PiAgentGui.Views.SourceControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PiAgentGui.Models.SourceControl"
    xmlns:controls="using:PiAgentGui.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ChangeRow" x:DataType="models:GitChange">
            <Grid ColumnSpacing="8" Padding="10,7" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.ContextFlyout><MenuFlyout>
                    <controls:ActionMenuFlyoutItem Text="{x:Bind OpenLabel}" Tag="{x:Bind}" Click="OnViewDiff"/>
                    <controls:ActionMenuFlyoutItem Text="{x:Bind ActionLabel}" Tag="{x:Bind}" Click="OnChangeAction" Visibility="{x:Bind IsRegularChange, Converter={StaticResource BooleanToVisibility}}"/>
                    <controls:ActionMenuFlyoutItem Text="Revert…" Tag="{x:Bind}" Click="OnRevert" Visibility="{x:Bind CanRevert, Converter={StaticResource BooleanToVisibility}}"/>
                </MenuFlyout></Grid.ContextFlyout>
                <controls:ActionButton Tag="{x:Bind}" Click="OnViewDiff" Padding="2" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{x:Bind OpenLabel}" AutomationProperties.Name="{x:Bind OpenLabel}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Path}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsConflict, Converter={StaticResource BooleanToVisibility}}"/>
                        <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                </controls:ActionButton>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind AddedText}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="{x:Bind RemovedText}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Text="{x:Bind Note}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <controls:ActionButton Grid.Column="2" Tag="{x:Bind}" Click="OnChangeAction" Padding="5" MinHeight="26" MinWidth="26"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{x:Bind ActionLabel}" AutomationProperties.Name="{x:Bind ActionLabel}">
                    <FontIcon Glyph="{x:Bind ActionGlyph}" FontSize="11"/>
                </controls:ActionButton>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12,0,0,0" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Height="36">
            <TextBlock Text="Source Control" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <controls:ActionButton HorizontalAlignment="Right" Click="OnClose" Padding="6" MinWidth="28" MinHeight="28" Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="Close source control" AutomationProperties.Name="Close source control"><FontIcon Glyph="&#xE711;" FontSize="11"/></controls:ActionButton>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
            <controls:ActionButton Click="OnBranches" IsEnabled="{Binding CanAct}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Branches">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Width="16" Height="16" Style="{StaticResource GitIconStyle}"/>
                    <TextBlock Text="{Binding BranchName}" FontSize="12"/><FontIcon Glyph="&#xE70D;" FontSize="9"/>
                </StackPanel>
            </controls:ActionButton>
            <InfoBar IsOpen="{Binding HasError}" Message="{Binding Error}" Severity="Error" IsClosable="False"/>
            <InfoBar IsOpen="{Binding HasNotice}" Message="{Binding Notice}" Severity="Success" IsClosable="True"/>
            <InfoBar IsOpen="{Binding HasConflicts}" Message="{Binding ConflictMessage}" Severity="Warning" IsClosable="False"/>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanAct}">
            <StackPanel Spacing="8" Visibility="{Binding HasRepository, Converter={StaticResource BooleanToVisibility}}">
                <controls:ActionExpander Header="{Binding ConflictsLabel}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource ChangeRow}"/>
                </controls:ActionExpander>
                <controls:ActionExpander Header="{Binding StagedLabel}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel><controls:ActionButton Content="Unstage all" Click="OnUnstageAll" IsEnabled="{Binding CanUnstageAll}" FontSize="11" Padding="6,3"/>
                    <ItemsControl ItemsSource="{Binding Staged}" ItemTemplate="{StaticResource ChangeRow}"/></StackPanel>
                </controls:ActionExpander>
                <controls:ActionExpander Header="{Binding ChangesLabel}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel><controls:ActionButton Content="Stage all" Click="OnStageAll" IsEnabled="{Binding CanStageAll}" FontSize="11" Padding="6,3"/>
                    <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource ChangeRow}"/></StackPanel>
                </controls:ActionExpander>
                <controls:ActionExpander Header="More actions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <ComboBox Header="Remote for first push" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        <controls:ActionButton Content="Refresh" Click="OnRefresh" HorizontalAlignment="Stretch"/>
                        <controls:ActionButton Content="Fetch all remotes" Click="OnFetch" HorizontalAlignment="Stretch"/>
                        <controls:ActionButton Content="Pull (fast-forward only)" Click="OnPull" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </controls:ActionExpander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibility}}"/>
        <StackPanel Grid.Row="3" Spacing="8" Padding="0,8,0,0" Visibility="{Binding HasRepository, Converter={StaticResource BooleanToVisibility}}">
            <TextBox Text="{Binding CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Commit message" AutomationProperties.Name="Commit message"
                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" MaxLength="8192" IsEnabled="{Binding CanAct}" FontSize="12"/>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:ActionButton Content="Commit" Click="OnCommit" IsEnabled="{Binding CanCommit}" HorizontalAlignment="Stretch"/>
                <controls:ActionButton Grid.Column="1" Content="Push" Click="OnPush" IsEnabled="{Binding CanPush}" HorizontalAlignment="Stretch"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
