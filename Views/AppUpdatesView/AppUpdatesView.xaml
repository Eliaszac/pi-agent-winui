<UserControl x:Class="PiAgentGui.Views.AppUpdatesView" x:Name="UpdatesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">
        <StackPanel Spacing="4" Visibility="{Binding SearchCategory.Items[Status].Visible, ElementName=UpdatesRoot, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="Pi desktop" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Grid ColumnSpacing="14" Visibility="{Binding SearchCategory.Items[Status].Visible, ElementName=UpdatesRoot, Converter={StaticResource BooleanToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <FontIcon x:Name="StatusIcon" Glyph="{Binding Icon}" FontSize="17"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="StatusTitle" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="StatusDetail" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ProgressBar x:Name="DownloadProgress" Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibility}}" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" HorizontalAlignment="Stretch" MaxWidth="420"/>
                <Button x:Name="UpdateAction" Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Click="OnAction" HorizontalAlignment="Left"/>
                <TextBlock x:Name="RestartNote" Visibility="{Binding ShowRestartNote, Converter={StaticResource BooleanToVisibility}}" Text="Your conversations are kept. Finish active runs before restarting." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <StackPanel Spacing="16">
            <StackPanel Spacing="4" Visibility="{Binding SearchCategory.Items[Checks].Visible, ElementName=UpdatesRoot, Converter={StaticResource BooleanToVisibility}}">
                <ToggleSwitch x:Name="CheckToggle" IsEnabled="{Binding CanEditPreferences}" Header="Check for updates automatically" IsOn="{Binding AutomaticChecks, Mode=OneWay}" Toggled="OnPreferencesChanged"/>
                <TextBlock Text="Check in the background when Pi desktop opens." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{Binding SearchCategory.Items[Downloads].Visible, ElementName=UpdatesRoot, Converter={StaticResource BooleanToVisibility}}">
                <ToggleSwitch x:Name="DownloadToggle" IsEnabled="{Binding CanEditPreferences}" Header="Download updates automatically" IsOn="{Binding AutomaticDownloads, Mode=OneWay}" Toggled="OnPreferencesChanged"/>
                <TextBlock Text="Have the update ready. You choose when to install and restart." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
        <Button Content="Restore Updates defaults…" Click="OnRestoreDefaults" HorizontalAlignment="Left"
            IsEnabled="{Binding CanEditPreferences}"
            Visibility="{Binding SearchCategory.Items[Defaults].Visible, ElementName=UpdatesRoot, Converter={StaticResource BooleanToVisibility}}"/>
    </StackPanel>
</UserControl>
