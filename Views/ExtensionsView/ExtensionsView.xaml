<UserControl x:Class="PiAgentGui.Views.ExtensionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls"
    xmlns:extensions="using:PiAgentGui.ViewModels.Extensions">
    <GridView x:Name="ExtensionCards" ItemsSource="{Binding Cards}" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False"
        SizeChanged="OnCardsSizeChanged" Loaded="OnCardsLoaded"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
        AutomationProperties.Name="Supported and recommended extensions">
        <GridView.Header>
            <StackPanel Spacing="6" Margin="0,0,0,24">
                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Extensions" FontSize="24" FontWeight="SemiBold" />
                    <controls:ActionButton Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource ShellIconButtonStyle}"
                        AutomationProperties.Name="Refresh all extensions" ToolTipService.ToolTip="Refresh all extensions">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </controls:ActionButton>
                </Grid>
                <TextBlock Text="Optional Pi extensions for your projects. Workspace checkpoints is maintained by Pi desktop; third-party extensions are attributed to their independent authors. Enable or set up each feature below." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </StackPanel>
        </GridView.Header>
        <GridView.ItemsPanel>
            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="extensions:ExtensionCardViewModel">
                <Border Padding="20" Margin="0,0,12,12" CornerRadius="8" BorderThickness="1" Loaded="OnCardLoaded"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12" SizeChanged="OnCardContentSizeChanged">
                        <TextBlock Text="{x:Bind Definition.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Attribution}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind VersionLabel}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Definition.Description}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Content="Details" Click="OnDetailsClicked" />
                            <controls:ActionButton Content="{Binding SetupLabel}" Click="OnSetupClicked"
                                Visibility="{x:Bind NeedsSetup, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </GridView.ItemTemplate>
        <GridView.Footer>
            <StackPanel Spacing="12" Margin="0,20,12,20" HorizontalAlignment="Stretch"
                Visibility="{Binding HasOtherExtensions, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="Other installed extensions" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Third-party extensions found in your global Pi installation. These are not managed or specifically supported by Pi desktop. Presence on disk does not confirm they are enabled or loaded. Project-local extensions are not listed here."
                    TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding OtherExtensions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="extensions:InstalledExtension">
                            <StackPanel Spacing="4" Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Origin}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GridView.Footer>
    </GridView>
</UserControl>

