<UserControl x:Class="PiAgentGui.Views.FileExplorerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:files="using:PiAgentGui.ViewModels.Files"
    xmlns:controls="using:PiAgentGui.Controls">
    <UserControl.Resources>
        <Style x:Key="FolderChevronStyle" TargetType="controls:ActionButton">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:ActionButton">
                <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Padding="12,8" ColumnSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Files" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <controls:ActionButton Grid.Column="1" Click="OnRefresh" Style="{StaticResource ShellIconButtonStyle}" ToolTipService.ToolTip="Refresh files" AutomationProperties.Name="Refresh files"><FontIcon Glyph="&#xE72C;" FontSize="13"/></controls:ActionButton>
            <controls:ActionButton Grid.Column="2" Click="OnClose" Style="{StaticResource ShellIconButtonStyle}" ToolTipService.ToolTip="Close files" AutomationProperties.Name="Close files"><FontIcon Glyph="&#xE711;" FontSize="12"/></controls:ActionButton>
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="{Binding HasError}" Message="{Binding Error}" Severity="Error" IsClosable="False"/>
        <ListView x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent"
            KeyDown="OnListKeyDown" ContextRequested="OnBackgroundContextRequested" AutomationProperties.Name="Project files" Padding="4,0,4,8">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
            <ListView.Resources>
                <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush"/>
                <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush"/>
                <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="TextFillColorSecondaryBrush"/>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="files:ExplorerItem">
                    <controls:ExplorerRowGrid Tag="{x:Bind}" Background="Transparent" MinHeight="24" ContextRequested="OnContextRequested" AutomationProperties.Name="{x:Bind Name}"
                        Tapped="OnRowTapped" DoubleTapped="OnDoubleTapped" CanDrag="True" DragStarting="OnDragStarting" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                        <Grid ColumnSpacing="5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="{x:Bind IndentWidth}"/>
                            <Grid Grid.Column="1" Width="18">
                                <controls:ActionButton Tag="{x:Bind}" Click="OnToggle" Style="{StaticResource FolderChevronStyle}" Padding="0" MinWidth="18" MinHeight="22" Background="Transparent" BorderThickness="0"
                                    Visibility="{x:Bind CanExpand, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="Expand or collapse folder">
                                    <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="9"/>
                                </controls:ActionButton>
                            </Grid>
                            <Image Grid.Column="2" Width="14" Height="14" Tag="{x:Bind IconName, Mode=OneWay}" Loaded="OnIconLoaded" Unloaded="OnIconUnloaded" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ShowName, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"/>
                            <TextBox Grid.Column="3" Text="{x:Bind Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}" FontSize="11" MinWidth="60" Padding="4,1" MinHeight="24"
                                KeyDown="OnNameKeyDown" Loaded="OnNameLoaded" Unloaded="OnNameUnloaded" Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"/>
                        </Grid>
                    </controls:ExplorerRowGrid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
