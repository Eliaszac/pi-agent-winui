<UserControl x:Class="PiAgentGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="16" Margin="8,16,8,32">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
            <TextBox PlaceholderText="Search settings" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search settings" Margin="0,0,0,8"/>
            <InfoBar IsOpen="{Binding HasMessage}" Message="{Binding Message}" Severity="Informational" IsClosable="False"/>
            <TextBlock Text="No matching settings. Try a different search." TextWrapping="Wrap" Visibility="{Binding NoResults, Converter={StaticResource BooleanToVisibility}}"/>
            <Expander IsEnabled="{Binding CanEdit}" Header="Appearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding Appearance.Expanded, Mode=TwoWay}" Visibility="{Binding Appearance.Visible, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Spacing="16">
                    <ComboBox x:Name="ThemeChoice" Header="Theme" SelectedIndex="{Binding ThemeIndex, Mode=OneWay}" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
                        <ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
                    </ComboBox>
                    <NumberBox Header="Conversation text size" Value="{Binding ConversationTextSize, Mode=OneWay}" Minimum="12" Maximum="22" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnBodySizeChanged" AutomationProperties.Name="Conversation text size" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="BodyPreview" Text="A little more room to read." FontSize="{Binding ConversationTextSize}" TextWrapping="Wrap"/>
                    <ComboBox x:Name="TextWeightChoice" Header="Response text weight" SelectedIndex="{Binding TextWeightIndex, Mode=OneWay}" SelectionChanged="OnTextWeightChanged" AutomationProperties.Name="Response text weight">
                        <ComboBoxItem Content="Regular"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Semibold"/>
                    </ComboBox>
                    <TextBlock Text="Changes letter thickness without changing the font. Bold text and headings stay emphasized." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <NumberBox Header="Code text size" Value="{Binding CodeTextSize, Mode=OneWay}" Minimum="10" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnCodeSizeChanged" AutomationProperties.Name="Code text size" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock Text="print('Hello, world!')" FontFamily="Consolas" FontSize="{Binding CodeTextSize}" TextWrapping="Wrap"/>
                    <controls:ActionButton Content="Reset text sizes" Click="OnResetTextSizes" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>
            <Expander IsEnabled="{Binding CanEdit}" Header="Conversation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding Conversation.Expanded, Mode=TwoWay}" Visibility="{Binding Conversation.Visible, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Spacing="10">
                    <ComboBox x:Name="SendKeyChoice" Header="Send a message with" SelectedIndex="{Binding SendKeyIndex, Mode=OneWay}" SelectionChanged="OnSendKeyChanged" AutomationProperties.Name="Send a message with">
                        <ComboBoxItem Content="Enter"/><ComboBoxItem Content="Ctrl + Enter"/>
                    </ComboBox>
                    <TextBlock Text="The other shortcut inserts a new line. Enter still selects suggestions when a picker is open." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Expander>
            <Expander IsEnabled="{Binding CanEdit}" Header="General" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding General.Expanded, Mode=TwoWay}" Visibility="{Binding General.Visible, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="On startup" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose where the app opens. Existing conversations are kept either way." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="Startup" SelectedIndex="{Binding StartupIndex, Mode=OneWay}" SelectionChanged="OnStartupChanged" AutomationProperties.Name="Startup page" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Home"/><ComboBoxItem Content="Most recently opened conversation"/>
                    </ComboBox>
                    <Border Height="1" Margin="0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <ComboBox x:Name="EditorChoice" Header="Preferred editor" DisplayMemberPath="Name" SelectionChanged="OnEditorChanged" AutomationProperties.Name="Preferred editor"/>
                    <TextBlock x:Name="EditorStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <controls:ActionButton Content="Refresh editors" Tag="editors" Click="OnDataAction" HorizontalAlignment="Left"/>
                    <Border Height="1" Margin="0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <TextBlock Text="Command palette" FontWeight="SemiBold"/>
                    <TextBlock Text="Commands are ordered by use. Reset clears counts and recency; search text is never stored." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <controls:ActionButton Content="Reset command ranking" Tag="palette" Click="OnDataAction" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>
            <Expander IsEnabled="{Binding CanEdit}" Header="Local usage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding Usage.Expanded, Mode=TwoWay}" Visibility="{Binding Usage.Visible, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="UsageToggle" Header="Show local usage on Home" IsOn="{Binding ShowLocalUsage, Mode=OneWay}" Toggled="OnUsageChanged"/>
                    <TextBlock Text="Usage metadata is stored locally and survives conversation deletion. Turning this off hides Home analytics; it does not stop local usage retention. Reset usage totals to clear retained history without deleting chats. Nothing is sent to the publisher." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding UsageResetLabel}" FontSize="12"/>
                    <controls:ActionButton Content="Reset usage totals…" Click="OnResetUsage" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>
            <Expander IsEnabled="{Binding CanEdit}" Header="Data management" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding Data.Expanded, Mode=TwoWay}" Visibility="{Binding Data.Visible, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Conversations" FontWeight="SemiBold"/>
                        <TextBlock Text="Delete this app’s saved conversations, including screenshots in their messages and associated restore data. Your project folders and shared Pi configuration remain." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <controls:ActionButton Content="Delete all conversations…" Tag="conversations" Click="OnDataAction" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Project registrations" FontWeight="SemiBold"/>
                        <TextBlock Text="Remove all projects from the sidebar and delete their conversations. Files in Windows, WSL and SSH project folders are never deleted by this action." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <controls:ActionButton Content="Remove all projects…" Tag="projects" Click="OnDataAction" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Restore data and other storage" FontWeight="SemiBold"/>
                        <TextBlock Text="Manage restore snapshots from Workspace checkpoints in Extensions. Research records, preferences, diagnostic files and shared provider credentials are separate from conversation deletion. Remote cleanup may remain pending until its target is available." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <controls:ActionButton Content="Manage extensions" Tag="extensions" Click="OnDataAction" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander IsEnabled="{Binding CanEdit}" Header="About" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding About.Expanded, Mode=TwoWay}" Visibility="{Binding About.Visible, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
                    <TextBlock Text="An independent, open-source desktop frontend for Pi. Published by Eliaszac, Denmark." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <controls:ActionButton Content="Legal &amp; privacy" Click="OnLegal" HorizontalAlignment="Left"/>
                    <HyperlinkButton Content="Source code on GitHub" NavigateUri="https://github.com/Eliaszac/pi-agent-winui" HorizontalAlignment="Left" Padding="0"/>
                    <HyperlinkButton Content="eliaszacho@gmail.com" NavigateUri="mailto:eliaszacho@gmail.com" HorizontalAlignment="Left" Padding="0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
