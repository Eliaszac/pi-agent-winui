<controls:ActionContentDialog x:Class="PiAgentGui.Views.FileDiffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PiAgentGui.Models.Conversations"
    xmlns:controls="using:PiAgentGui.Controls"
    CloseButtonText="Close" DefaultButton="Close">
    <controls:ActionContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">10000</x:Double>
        <Style x:Key="CodeRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="CodeRow" x:DataType="models:DiffLine">
            <Grid Height="20">
                <Border Background="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.12" Visibility="{x:Bind IsAdded, Converter={StaticResource BooleanToVisibility}}"/>
                <Border Background="{ThemeResource SystemFillColorCriticalBrush}" Opacity="0.12" Visibility="{x:Bind IsRemoved, Converter={StaticResource BooleanToVisibility}}"/>
                <Grid Padding="6,1,12,1" Visibility="{x:Bind IsCodeRow, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Number}" FontFamily="Consolas" FontSize="11" TextAlignment="Right" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Marker}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <controls:DiffCodeText Grid.Column="2" Line="{x:Bind}"/>
                </Grid>
                <controls:ActionButton Content="{x:Bind Text}" Tag="{x:Bind}" Click="OnRevealContext" Visibility="{x:Bind CanExpand, Converter={StaticResource BooleanToVisibility}}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,0" MinHeight="20" Height="20" FontSize="11" BorderThickness="0" Background="Transparent"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Show 15 more unchanged lines"/>
            </Grid>
        </DataTemplate>
    </controls:ActionContentDialog.Resources>
    <Grid x:Name="Body" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Description" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <controls:ActionToggleButton x:Name="ChangesOnly" Grid.Column="1" IsChecked="True" Click="OnChangesOnlyChanged" Width="32" Height="32" Padding="6"
                AutomationProperties.Name="Changes only" ToolTipService.ToolTip="Changes only · hide unchanged lines">
                <Viewbox Width="16" Height="16"><Canvas Width="20" Height="20">
                    <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M 3,2 L 17,2 M 10,4 L 10,8 M 7,6 L 10,9 L 13,6 M 3,18 L 17,18 M 10,16 L 10,12 M 7,14 L 10,11 L 13,14"/>
                </Canvas></Viewbox>
            </controls:ActionToggleButton>
            <ComboBox x:Name="LayoutMode" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnLayoutChanged" AutomationProperties.Name="Diff layout" MinWidth="90">
                <ComboBoxItem Content="Split"/><ComboBoxItem Content="Inline"/>
            </ComboBox>
            <controls:CopyFeedbackButton Grid.Column="3" Click="OnCopy" Style="{StaticResource ShellIconButtonStyle}" AutomationProperties.Name="Copy diff" ToolTipService.ToolTip="Copy diff"/>
        </Grid>
        <TextBlock x:Name="Notice" Grid.Row="1" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        <Grid x:Name="SplitView" Grid.Row="2" ColumnSpacing="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="LeftLabel" FontSize="11" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
                <ListView x:Name="LeftLines" Grid.Row="1" SelectionMode="None" Padding="0" ItemTemplate="{StaticResource CodeRow}" ItemContainerStyle="{StaticResource CodeRowStyle}"
                    ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Auto" Loaded="OnListsLoaded">
                    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="RightLabel" FontSize="11" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
                <ListView x:Name="RightLines" Grid.Row="1" SelectionMode="None" Padding="0" ItemTemplate="{StaticResource CodeRow}" ItemContainerStyle="{StaticResource CodeRowStyle}"
                    ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Auto" Loaded="OnListsLoaded">
                    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                </ListView>
            </Grid>
        </Grid>
        <controls:FileDiffView x:Name="InlineView" Grid.Row="2" IsFullView="True" RevealContextRequested="OnInlineReveal" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</controls:ActionContentDialog>
