<UserControl x:Class="PiAgentGui.Views.LegalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls">
    <Grid RowSpacing="16" MaxWidth="1000" Margin="8,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <controls:ActionButton Content="Back to Settings" Click="OnBack" HorizontalAlignment="Left"/>
            <TextBlock Text="Legal &amp; privacy" FontSize="28" FontWeight="SemiBold"/>
        </StackPanel>
        <ComboBox x:Name="DocumentPicker" Grid.Row="1" SelectionChanged="OnDocumentChanged" AutomationProperties.Name="Legal document" HorizontalAlignment="Stretch"/>
        <ScrollViewer x:Name="DocumentScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <ContentControl x:Name="DocumentContent" HorizontalContentAlignment="Stretch" Margin="0,0,16,24"/>
        </ScrollViewer>
    </Grid>
</UserControl>
