<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>
  <!-- Compile the UI-independent production files directly; no WinUI runtime is needed. -->
  <ItemGroup>
    <Content Include="../PiExtensions/*.ts" Link="PiExtensions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Models/Pi/*.cs" Link="Production/Models/Pi/%(Filename)%(Extension)" />
    <Compile Include="../Models/Conversations/*.cs" Link="Production/Models/Conversations/%(Filename)%(Extension)" />
    <Compile Include="../Configuration/PiRuntimeOptions.cs" Link="Production/Configuration/PiRuntimeOptions.cs" />
    <Compile Include="../Configuration/ApplicationIdentity.cs" Link="Production/Configuration/ApplicationIdentity.cs" />
    <Compile Include="../Services/Pi/*.cs" Link="Production/Services/Pi/%(Filename)%(Extension)" />
    <Compile Include="../Services/Conversations/*.cs" Link="Production/Services/Conversations/%(Filename)%(Extension)" />
    <Compile Include="../Models/Projects/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
    <Compile Include="../Configuration/ProjectStorageOptions.cs" Link="Production/Configuration/ProjectStorageOptions.cs" />
    <Compile Include="../Utilities/*.cs" Link="Production/Utilities/%(Filename)%(Extension)" />
    <Compile Include="../ViewModels/**/*.cs" Link="Production/ViewModels/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Validators/ProjectValidator.cs" Link="Production/Validators/ProjectValidator.cs" />
    <Compile Include="../Repositories/Projects/*.cs" Link="Production/Repositories/%(Filename)%(Extension)" />
    <Compile Include="../Services/Projects/*.cs" Link="Production/Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
