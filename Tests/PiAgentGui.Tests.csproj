<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>
  <!-- Compile the UI-independent production files directly; no WinUI runtime is needed. -->
  <ItemGroup>
    <Compile Include="../Models/Home/*.cs" Link="Production/Models/Home/%(Filename)%(Extension)" />
    <Compile Include="../Services/Home/*.cs" Link="Production/Services/Home/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Models/Docker/*.cs" Link="Production/Models/Docker/%(Filename)%(Extension)" />
    <Compile Include="../Services/Docker/*.cs" Link="Production/Services/Docker/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Assets/Syntax/**/*" Link="Assets/Syntax/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Services/Terminal/*.cs" Link="Production/Services/Terminal/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Models/GitHub/*.cs" Link="Production/Models/GitHub/%(Filename)%(Extension)" />
    <Compile Include="../Services/GitHub/*.cs" Exclude="../Services/GitHub/WindowsGitHubCredentialStore.cs" Link="Production/Services/GitHub/%(Filename)%(Extension)" />
    <Compile Include="../Configuration/GitHubOptions.cs" Link="Production/Configuration/GitHubOptions.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Models/Applications/*.cs" Link="Production/Models/Applications/%(Filename)%(Extension)" />
    <Compile Include="../Services/Applications/*.cs" Link="Production/Services/Applications/%(Filename)%(Extension)" />
    <Compile Include="../Services/Files/*.cs" Link="Production/Services/Files/%(Filename)%(Extension)" />
    <Compile Include="../Models/SourceControl/*.cs" Link="Production/Models/SourceControl/%(Filename)%(Extension)" />
    <Compile Include="../Services/SourceControl/*.cs" Link="Production/Services/SourceControl/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../PiExtensions/*.ts" Link="PiExtensions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Models/Pi/*.cs" Link="Production/Models/Pi/%(Filename)%(Extension)" />
    <Compile Include="../Models/Conversations/*.cs" Link="Production/Models/Conversations/%(Filename)%(Extension)" />
    <Compile Include="../Configuration/PiRuntimeOptions.cs" Link="Production/Configuration/PiRuntimeOptions.cs" />
    <Compile Include="../Configuration/ApplicationIdentity.cs" Link="Production/Configuration/ApplicationIdentity.cs" />
    <Compile Include="../Services/Pi/*.cs" Link="Production/Services/Pi/%(Filename)%(Extension)" />
    <Compile Include="../Services/Conversations/*.cs" Link="Production/Services/Conversations/%(Filename)%(Extension)" />
    <Compile Include="../Models/Projects/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
    <Compile Include="../Configuration/ProjectStorageOptions.cs" Link="Production/Configuration/ProjectStorageOptions.cs" />
    <Compile Include="../Utilities/*.cs" Link="Production/Utilities/%(Filename)%(Extension)" />
    <Compile Include="../ViewModels/**/*.cs" Link="Production/ViewModels/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Validators/ProjectValidator.cs" Link="Production/Validators/ProjectValidator.cs" />
    <Compile Include="../Repositories/Projects/*.cs" Link="Production/Repositories/%(Filename)%(Extension)" />
    <Compile Include="../Services/Projects/*.cs" Link="Production/Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
