<UserControl x:Class="PiAgentGui.Controls.TargetWorkspaceForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls">
    <StackPanel Spacing="24">
        <StackPanel Spacing="12">
            <RadioButtons Header="Run on" MaxColumns="3" SelectedIndex="{Binding TargetKindIndex, Mode=TwoWay}">
                <x:String>Local Windows</x:String><x:String>WSL</x:String><x:String>Remote SSH</x:String>
            </RadioButtons>
            <TextBox Header="SSH host" PlaceholderText="dev-server or elias@hostname" Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsSsh, Converter={StaticResource BooleanToVisibility}}" />
            <StackPanel Spacing="12" Visibility="{Binding IsSsh, Converter={StaticResource BooleanToVisibility}}">
                <ComboBox Header="Authentication" HorizontalAlignment="Stretch" SelectedIndex="{Binding SshAuthenticationIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Key / SSH agent" /><ComboBoxItem Content="Password" />
                </ComboBox>
                <TextBox Header="Private key file (optional)" PlaceholderText="C:\Users\elias\.ssh\id_ed25519"
                    Text="{Binding SshKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsKeyAuthentication, Converter={StaticResource BooleanToVisibility}}" />
                <PasswordBox x:Name="SshSecretBox" Header="{Binding SshSecretLabel}" PlaceholderText="Enter password or passphrase" PasswordChanged="OnSshSecretChanged" />
                <TextBlock Text="{Binding SshSecretHint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <controls:WslDistributionPicker x:Name="WslPicker" Visibility="{Binding IsWsl, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
        <StackPanel Spacing="16">
            <RadioButtons Header="Workspace" MaxColumns="2" SelectedIndex="{Binding SourceIndex, Mode=TwoWay}">
                <x:String>Existing folder</x:String><x:String>Clone repository</x:String>
            </RadioButtons>
            <TextBox Header="Repository URL" PlaceholderText="https://github.com/owner/repository.git"
                Text="{Binding RepositoryUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding CloneRepository, Converter={StaticResource BooleanToVisibility}}" />
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding FolderLabel}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="{Binding FolderPlaceholder}" Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding FolderLabel}" />
                    <controls:ActionButton x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="OnBrowseClicked"
                        Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding FolderHint}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BrowseError" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
