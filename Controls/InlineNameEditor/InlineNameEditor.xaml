<UserControl
    x:Class="PiAgentGui.Controls.InlineNameEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <StackPanel x:Name="Root" Spacing="4" Margin="4,2">
        <TextBox x:Name="NameBox" Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding CanEdit}" KeyDown="OnKeyDown" LostFocus="OnLostFocus"
            AutomationProperties.Name="Name" ToolTipService.ToolTip="Enter to save; Escape to cancel" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12"
            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
