                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SystemColorButtonTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SystemColorButtonTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SystemColorButtonTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
