<UserControl x:Class="PiAgentGui.Controls.ArtifactCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls">
    <Border Padding="12" CornerRadius="12" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="9" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DropDownButton Grid.Column="2" Content="Open in" VerticalAlignment="Center" Padding="10,5" FontSize="12" CornerRadius="14"
                IsEnabled="{Binding Available}" AutomationProperties.Name="Artifact actions">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <controls:ActionMenuFlyoutItem Text="Attach to message" Tag="attach" Click="OnAction"><controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE723;"/></controls:ActionMenuFlyoutItem.Icon></controls:ActionMenuFlyoutItem>
                        <controls:ActionMenuFlyoutItem Text="Preview" Tag="preview" Click="OnAction"><controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE890;"/></controls:ActionMenuFlyoutItem.Icon></controls:ActionMenuFlyoutItem>
                        <controls:ActionMenuFlyoutItem Text="Default app" Tag="open" Click="OnAction"><controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></controls:ActionMenuFlyoutItem.Icon></controls:ActionMenuFlyoutItem>
                        <controls:ActionMenuFlyoutItem Text="Save a copy…" Tag="save" Click="OnAction"><controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></controls:ActionMenuFlyoutItem.Icon></controls:ActionMenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <controls:ActionMenuFlyoutItem Text="Rename…" Tag="rename" Click="OnAction"><controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;"/></controls:ActionMenuFlyoutItem.Icon></controls:ActionMenuFlyoutItem>
                        <controls:ActionMenuFlyoutItem Text="Delete…" Tag="delete" Click="OnAction"><controls:ActionMenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></controls:ActionMenuFlyoutItem.Icon></controls:ActionMenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
    </Border>
</UserControl>
