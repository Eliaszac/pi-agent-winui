<UserControl x:Class="PiAgentGui.Controls.PendingIntegrationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiAgentGui.Controls" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:IntegrationLogo Integration="{x:Bind Integration}" Width="28" Height="28" VerticalAlignment="Top" Opacity="0.65" AutomationProperties.AccessibilityView="Raw"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Coming soon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <controls:ActionButton Content="Connect" IsEnabled="False" HorizontalAlignment="Left" AutomationProperties.Name="Connection not available yet"/>
        </StackPanel>
    </Border>
</UserControl>
